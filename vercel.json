{
    "version": 2,
    "buildCommand": "cd backend && npm install",
    "outputDirectory": "frontend",
    "env": {
        "SUPABASE_URL": {
            "required": true
        },
        "SUPABASE_ANON_KEY": {
            "required": true
        },
        "SUPABASE_SERVICE_ROLE_KEY": {
            "required": true
        },
        "MARKET_DATA_API_KEY": {
            "required": false
        },
        "MARKET_DATA_BASE_URL": {
            "required": false
        },
        "PRICE_CACHE_TTL_SECONDS": {
            "required": false
        },
        "RESEND_API_KEY": {
            "required": false
        },
        "EMAIL_FROM": {
            "required": false
        },
        "ENVIRONMENT": {
            "required": false
        }
    },
    "functions": {
        "backend/api/**/*.js": {
            "memory": 3008,
            "maxDuration": 60,
            "runtime": "nodejs20.x"
        }
    },
    "regions": [
        "iad1"
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/backend/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}