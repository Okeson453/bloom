# ──────────────────────────────────────────────────────────────────────────
# BLOOM FINANCE - ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values
# For production (Vercel), add these to Vercel Dashboard → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API > Project Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── MARKET DATA API (Polygon.io) ──────────────────────────────────────────
# Get your free API key at: https://polygon.io/
# Used for fetching real-time stock quotes, market data
MARKET_DATA_API_KEY=your-polygon-io-key-here
MARKET_DATA_BASE_URL=https://api.polygon.io/v2

# Price cache TTL in seconds (how long we cache market data)
MARKET_DATA_CACHE_TTL=900

# ── EMAIL SERVICE (Resend) ────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Used for sending emails (confirmations, notifications, etc.)
RESEND_API_KEY=re_your_api_key_here

# ── API BASE URL ──────────────────────────────────────────────────────────
# Automatically set by the frontend config/api.js (uses current origin)
# Leave this alone for Vercel - it works dynamically
# For local dev: http://localhost:3000/api

# ── OPTIONAL: JWT SECRET for local Supabase testing ──────────────────────
# Only needed if testing with local Supabase
# Leave blank for production (Supabase handles JWT)
TEST_JWT_TOKEN=your-test-token-here

# ── OPTIONAL: Additional API Keys ─────────────────────────────────────────
# Add any additional service API keys here as needed
# Example:
# STRIPE_API_KEY=sk_...
# STRIPE_PUBLIC_KEY=pk_...
