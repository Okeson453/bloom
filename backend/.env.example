# ─────────────────────────────────────────────────────────────────
# Bloom Finance Backend — Environment Variables
# Supabase + Vercel Architecture
# ─────────────────────────────────────────────────────────────────

# ── App Environment ──────────────────────────────────────────────
# Options: local | staging | production
ENVIRONMENT=local

# ── Supabase ──────────────────────────────────────────────────────
# Get these from your Supabase project settings
# Project > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Market Data API (Polygon.io) ──────────────────────────────────
# Get your free API key at: https://polygon.io/
# Leave as-is for mock data in local dev
MARKET_DATA_API_KEY=your_api_key_here
MARKET_DATA_BASE_URL=https://api.polygon.io/v2

# Price cache TTL in seconds (how long Supabase caches prices)
PRICE_CACHE_TTL_SECONDS=60

# ── Email (Resend) ────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=hello@bloomfinance.com

# ── Integration Tests ─────────────────────────────────────────────
# Provide a valid Supabase JWT access token for integration test runs
TEST_ACCESS_TOKEN=
TEST_USER_ID=
API_BASE_URL=http://localhost:3000

# ── Feature Flags ────────────────────────────────────────────────
# Enable/disable scheduled jobs in local dev
ENABLE_PRICE_REFRESH_SCHEDULE=false
ENABLE_PORTFOLIO_SNAPSHOT_SCHEDULE=false
ENABLE_MONTHLY_SUMMARY_SCHEDULE=false
