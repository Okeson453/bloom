{
  "name": "bloom-finance-backend",
  "version": "2.0.0",
  "description": "Bloom Finance — Serverless Backend (Vercel + Supabase, Node.js 20)",
  "author": "Bloom Finance Engineering",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vercel dev",
    "build": "vercel build",
    "build:local": "npm run lint && npm run test:unit",
    "start": "vercel dev",
    "vercel-build": "npm install",
    "deploy:staging": "vercel --prod --env staging",
    "deploy:prod": "vercel --prod",
    "db:push": "supabase db push --linked",
    "db:pull": "supabase db pull",
    "db:migrate": "supabase migration new",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit --coverage --verbose",
    "test:integration": "jest tests/integration --testTimeout=30000 --runInBand",
    "test:watch": "jest tests/unit --watch",
    "lint": "eslint api/ --ext .js",
    "lint:fix": "eslint api/ --ext .js --fix",
    "seed": "npm run seed:portfolios && npm run seed:articles",
    "seed:portfolios": "node --require ./scripts/setup.cjs scripts/seed-portfolios.cjs --env=local",
    "seed:articles": "node --require ./scripts/setup.cjs scripts/seed-articles.cjs --env=local",
    "seed:staging": "node --require ./scripts/setup.cjs scripts/seed-portfolios.cjs --env=staging && node --require ./scripts/setup.cjs scripts/seed-articles.cjs --env=staging",
    "validate": "supabase status"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "resend": "^3.0.0",
    "plaid": "^24.0.0",
    "stripe": "^14.18.0",
    "nanoid": "^5.0.7",
    "axios": "^1.6.8",
    "winston": "^3.11.0",
    "opossum": "^8.1.0",
    "joi": "^17.11.0",
    "crypto-js": "^4.2.0",
    "redis": "^4.6.0",
    "p-retry": "^6.1.0",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "api/**/*.js",
      "!api/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "coverageDirectory": "coverage",
    "verbose": true,
    "transform": {}
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": "error",
      "curly": "error"
    }
  }
}